{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tacair-kill.schema.json",
  "title": "TacAir Kill Table (45.5)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "table": {
      "const": "tacair-kill"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "differential",
          "kill_max"
        ],
        "additionalProperties": false,
        "properties": {
          "differential": {
            "$ref": "#/$defs/range"
          },
          "kill_max": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 11,
            "maximum": 66
          }
        }
      }
    }
  }
}
