{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aircraft-characteristics.schema.json",
  "title": "Aircraft Characteristics Charts (34.6; printed 4.44A Commonwealth, 4.44b Italian, 4.44c German)",
  "description": "One row per aircraft type and configuration. Values as printed: plain numbers as integers, marked or parenthesised cells as the printed string, dashes and blanks as null.",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "$defs": {
    "cell": {"type": ["integer", "string", "null"]},
    "mark": {"type": ["string", "null"]}
  },
  "properties": {
    "table": {"const": "aircraft-characteristics"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "nation", "aircraft", "table", "range", "tac_air", "maneuver", "bomb", "fuel", "missions", "manufacturer", "sources"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^aircraft:(cw|it|de):[a-z0-9-]+$"},
          "nation": {"$ref": "common.schema.json#/$defs/nation"},
          "aircraft": {"type": "string", "minLength": 1},
          "table": {"enum": ["fighter", "bomber"]},
          "alternative_of": {"type": "string", "pattern": "^aircraft:(cw|it|de):[a-z0-9-]+$"},
          "range": {"$ref": "#/$defs/cell"},
          "tac_air": {"$ref": "#/$defs/cell"},
          "maneuver": {"$ref": "#/$defs/cell"},
          "bomb": {"$ref": "#/$defs/cell"},
          "fuel": {"$ref": "#/$defs/cell"},
          "missions": {"type": "object", "additionalProperties": false,
                       "properties": {"F": {"$ref": "#/$defs/mark"}, "S": {"$ref": "#/$defs/mark"}, "R": {"$ref": "#/$defs/mark"},
                                      "D": {"$ref": "#/$defs/mark"}, "B": {"$ref": "#/$defs/mark"}, "Transport": {"$ref": "#/$defs/mark"}}},
          "manufacturer": {"type": ["string", "null"]},
          "sources": {"$ref": "common.schema.json#/$defs/sources"}
        }
      }
    }
  }
}
