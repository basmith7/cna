{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pilot-plane-recovery.schema.json",
  "title": "Pilot and Plane Recovery Table (45.6)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "table": {
      "const": "pilot-plane-recovery"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "die",
          "strafed",
          "shot_down"
        ],
        "additionalProperties": false,
        "properties": {
          "die": {
            "$ref": "#/$defs/range"
          },
          "strafed": {
            "type": "object",
            "required": [
              "plane"
            ],
            "additionalProperties": false,
            "properties": {
              "plane": {
                "enum": [
                  "repairable",
                  "lost"
                ]
              }
            }
          },
          "shot_down": {
            "type": "object",
            "required": [
              "plane",
              "pilot"
            ],
            "additionalProperties": false,
            "properties": {
              "plane": {
                "enum": [
                  "repairable",
                  "lost"
                ]
              },
              "pilot": {
                "enum": [
                  "survives",
                  "killed"
                ]
              }
            }
          }
        }
      }
    }
  }
}
