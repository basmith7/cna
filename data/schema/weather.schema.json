{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weather.schema.json",
  "title": "Weather Table (SPI 29.61)",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "weather"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["season", "turns", "weather", "sources"], "additionalProperties": false,
        "properties": {
          "season": {"enum": ["spring", "summer", "autumn", "winter"]},
          "turns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/band"}},
          "weather": {"type": "object", "required": ["normal", "hot", "sandstorm", "rainstorm"], "additionalProperties": false,
                      "properties": {"normal": {"$ref": "#/$defs/dice"}, "hot": {"$ref": "#/$defs/dice"},
                                     "sandstorm": {"$ref": "#/$defs/dice"}, "rainstorm": {"$ref": "#/$defs/dice"}}},
          "sources": {"$ref": "common.schema.json#/$defs/sources"}
        }
      }
    }
  },
  "$defs": {
    "band": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
             "properties": {"from": {"type": "integer", "minimum": 1}, "to": {"type": "integer", "minimum": 1}}},
    "dice": {"type": ["object", "null"], "required": ["from", "to"], "additionalProperties": false,
             "properties": {"from": {"type": "integer", "minimum": 11, "maximum": 66}, "to": {"type": "integer", "minimum": 11, "maximum": 66}},
             "description": "Sequential two-dice reading range, or null when the weather cannot occur"}
  }
}
