{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis-malta-availability.schema.json",
  "title": "Axis Malta Availability Table (44.42)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        }
      }
    }
  },
  "properties": {
    "table": {
      "const": "axis-malta-availability"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dice",
          "levels"
        ],
        "additionalProperties": false,
        "properties": {
          "dice": {
            "type": "integer",
            "minimum": 2,
            "maximum": 12
          },
          "levels": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": [
                    "in_play",
                    "strategic"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "in_play": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "strategic": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
