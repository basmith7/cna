{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reinforcement-schedule.schema.json",
  "title": "Land unit reinforcement and withdrawal schedules (4.43a Commonwealth, 4.43b Axis)",
  "description": "One row per printed entry: the Game-Turn and Operations Stage, the units that arrive or withdraw, and any first-line trucks that come with them. Units are OA ids (data/oa/).",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "table": {
      "const": "reinforcement-schedule"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "through": {
      "type": "integer",
      "minimum": 1,
      "maximum": 111,
      "description": "Last Game-Turn transcribed so far; rows after it are not yet in the file"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "side",
          "game_turn",
          "opstage",
          "kind",
          "units",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "side": {
            "$ref": "common.schema.json#/$defs/side"
          },
          "game_turn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 111
          },
          "opstage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "kind": {
            "enum": [
              "arrives",
              "withdraws"
            ]
          },
          "units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/unitId"
            }
          },
          "hq_only": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/unitId"
            },
            "description": "Units of this row printed 'HQ': the headquarters counter alone, without the units assigned to it"
          },
          "less": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/unitId"
            },
            "description": "Printed 'Less': units under the one named that do not go (or come back) with it"
          },
          "pick": {
            "type": "object",
            "required": [
              "count",
              "fills"
            ],
            "additionalProperties": false,
            "description": "Units the Commonwealth player chooses by type to withdraw with the row (20.81, 20.82; R-154)",
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 1
              },
              "fills": {
                "type": "string",
                "description": "A Formation Organisation slot kind (an OA counter's `fills`), e.g. infantry-battalion"
              }
            }
          },
          "trucks": {
            "$ref": "common.schema.json#/$defs/trucks"
          },
          "transport": {
            "type": "object",
            "required": [
              "truck_value",
              "motorisation"
            ],
            "additionalProperties": false,
            "description": "Printed 'Tpt: a/b' on a withdrawal: the truck value points (Light 1/2, Medium 1, Heavy 2) that must leave with it in the Logistics Game, and the motorisation points under abstract logistics (§32); R-154",
            "properties": {
              "truck_value": {
                "type": "integer",
                "minimum": 0
              },
              "motorisation": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "transport_from": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "game_turn",
                "opstage"
              ],
              "additionalProperties": false,
              "properties": {
                "game_turn": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 111
                },
                "opstage": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3
                }
              }
            },
            "description": "On a return printed 'Tpt: See ...': the withdrawals whose transport comes back with it"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sources": {
            "$ref": "common.schema.json#/$defs/sources"
          }
        }
      }
    },
    "unplaced": {
      "type": "array",
      "description": "Printed entries that bring no counter (trucks or replacement points only)",
      "items": {
        "type": "object",
        "required": [
          "side",
          "game_turn",
          "opstage"
        ],
        "properties": {
          "side": {
            "$ref": "common.schema.json#/$defs/side"
          },
          "game_turn": {
            "type": "integer"
          },
          "opstage": {
            "type": "integer"
          }
        }
      }
    }
  }
}
