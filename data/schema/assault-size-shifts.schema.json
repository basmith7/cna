{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assault-size-shifts.schema.json",
  "title": "Close assault column shifts for organisational size difference (SPI 15.53)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "table": {
      "const": "assault-size-shifts"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "larger",
          "smaller",
          "shift",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "larger": {
            "$ref": "#/$defs/orgSize",
            "description": "Largest unit equivalent on the bigger side"
          },
          "smaller": {
            "$ref": "#/$defs/orgSize",
            "description": "Largest unit equivalent on the smaller side"
          },
          "shift": {
            "type": "integer",
            "minimum": 0,
            "description": "Columns shifted on the Close Assault CRT in favour of the larger side (0 = the chart lists the pairing with no shift)"
          },
          "sources": {
            "$ref": "common.schema.json#/$defs/sources"
          }
        }
      }
    }
  },
  "$defs": {
    "orgSize": {
      "enum": [
        "division",
        "brigade-3",
        "brigade-2",
        "brigade",
        "battalion",
        "company"
      ],
      "description": "Unit equivalents per SPI 9.2: brigade-3 / brigade-2 are 3- and 2-SP brigades; 'brigade' is any brigade"
    }
  }
}
