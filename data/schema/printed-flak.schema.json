{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "printed-flak.schema.json",
  "title": "Flak printed on the map (SPI 41.85)",
  "type": "object", "required": ["table", "sources", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "printed-flak"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["box", "side", "aa_points", "heavy", "sources"], "additionalProperties": false,
      "properties": {
        "box": {"enum": ["tunis", "gabes", "tripoli", "tripolitania"],
                "description": "The off-map box the value is printed in; same ids as off-map-distances.json"},
        "side": {"const": "axis"},
        "aa_points": {"type": "integer", "minimum": 1,
                      "description": "AA points as printed: constant, never reduced by bombing (41.85)"},
        "heavy": {"const": true, "description": "Heavy flak under R-111: fighters cannot suppress it (40.74)"},
        "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
