{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "supply-dump-demolition.schema.json",
 "title": "Supply Dump Demolition Table (SPI 54.17)",
 "type": "object",
 "required": [
  "table",
  "sources",
  "rows",
  "modifiers"
 ],
 "additionalProperties": false,
 "properties": {
  "table": {
   "const": "supply-dump-demolition"
  },
  "sources": {
   "$ref": "common.schema.json#/$defs/sources"
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rows": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "die",
     "percent",
     "sources"
    ],
    "properties": {
     "die": {
      "type": "integer"
     },
     "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "Share of each supply type in the dump destroyed"
     },
     "or_more": {
      "const": true
     },
     "sources": {
      "$ref": "common.schema.json#/$defs/sources"
     }
    }
   }
  },
  "modifiers": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "id",
     "value",
     "group"
    ],
    "properties": {
     "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
     },
     "value": {
      "type": "integer"
     },
     "group": {
      "enum": [
       "effort",
       "size",
       "location",
       "capture"
      ],
      "description": "Modifiers in one group are alternatives (at most one applies); groups are cumulative. The dump-total pair applies only outside a major city"
     },
     "per": {
      "const": "extra-third-cpa"
     }
    }
   }
  }
 }
}
