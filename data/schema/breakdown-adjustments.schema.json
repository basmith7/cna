{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "breakdown-adjustments.schema.json",
  "title": "Breakdown Adjustment Rating summary by vehicle type (SPI 21.14)",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "breakdown-adjustments"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["vehicle", "shift", "sources"],
        "additionalProperties": false,
        "properties": {
          "vehicle": {"enum": ["truck", "armoured-car", "armoured-recce", "sp-gun", "tank"]},
          "shift": {"type": "integer", "description": "Columns on the Breakdown Table; negative = left (fewer breakdowns), positive = right"},
          "shift_max": {"type": "integer", "description": "Upper end of a per-model range; the model's own value is on its Tank & Gun Characteristics Chart"},
          "sources": {"$ref": "common.schema.json#/$defs/sources"}
        }
      }
    }
  }
}
