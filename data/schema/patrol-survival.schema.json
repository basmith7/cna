{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patrol-survival.schema.json",
  "title": "Patrol Survival Table (SPI 16.6)",
  "type": "object", "required": ["table", "sources", "recce_only_modifier", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "patrol-survival"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "recce_only_modifier": {"type": "integer", "description": "Added to the die when every patrolling TOE point is from recce units (chart asterisk)"},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["die", "killed", "captured", "sources"], "additionalProperties": false,
      "properties": {"die": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
                             "properties": {"from": {"type": "integer", "minimum": 0, "maximum": 6}, "to": {"type": "integer", "minimum": 0, "maximum": 6}}},
                     "killed": {"type": "integer", "minimum": 0}, "captured": {"type": "integer", "minimum": 0},
                     "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
