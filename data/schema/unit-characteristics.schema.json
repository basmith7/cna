{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "unit-characteristics.schema.json",
  "title": "Unit Characteristics Charts (4.46a Commonwealth, 4.46b Italian, 4.46c German)",
  "description": "Per nation and ID code: the CPA and combat ratings of a unit type. An OA unit's id_code keys into this table. Values as printed; a cell that is not a plain number (marked, parenthesised or a dash) is kept as the printed string, a blank is null.",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "$defs": {
    "cell": {"type": ["integer", "string", "null"]}
  },
  "properties": {
    "table": {"const": "unit-characteristics"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nation", "id_code", "unit_type", "equivalent", "cpa", "sources"],
        "additionalProperties": false,
        "properties": {
          "nation": {"$ref": "common.schema.json#/$defs/nation"},
          "id_code": {"type": "string", "pattern": "^[a-z]{1,3}$"},
          "unit_type": {"type": "string", "minLength": 1},
          "equivalent": {"enum": ["brigade", "battalion", "company", "hq", "by-unit"], "description": "Stacking equivalent of the unit type (SPI 9.22-9.24, 9.4), our reading of the type name; by-unit: each OA unit with this code gives its own equivalent"},
          "cpa": {"$ref": "#/$defs/cell"},
          "anti_air": {"$ref": "#/$defs/cell"},
          "barrage": {"$ref": "#/$defs/cell"},
          "anti_armour": {"$ref": "#/$defs/cell"},
          "vulnerability": {"$ref": "#/$defs/cell"},
          "armour_protection": {"$ref": "#/$defs/cell"},
          "close_assault_offence": {"$ref": "#/$defs/cell"},
          "close_assault_defence": {"$ref": "#/$defs/cell"},
          "max_toe": {"$ref": "#/$defs/cell"},
          "assign_note": {"type": ["string", "null"], "description": "Our words for the chart's attachment note (what TOE of another kind the unit may take)"},
          "sources": {"$ref": "common.schema.json#/$defs/sources"}
        }
      }
    }
  }
}
