{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cw-production.schema.json",
  "title": "Commonwealth Production System (SPI 20.78): truck table (A), infantry table (B), production chart (C)",
  "type": "object", "required": ["table", "sources", "trucks", "infantry", "chart"], "additionalProperties": false,
  "$defs": {
    "truckTriple": {"type": "object", "required": ["light", "medium", "heavy"], "additionalProperties": false,
                    "properties": {"light": {"type": "integer", "minimum": 0}, "medium": {"type": "integer", "minimum": 0}, "heavy": {"type": "integer", "minimum": 0}},
                    "description": "Truck points of each type produced on that die (one die per type)"}
  },
  "properties": {
    "table": {"const": "cw-production"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "trucks": {"type": "object", "required": ["arrive_turns_later", "alexandria_max_share", "rows"], "additionalProperties": false,
      "properties": {
        "arrive_turns_later": {"type": "integer", "minimum": 0},
        "alexandria_max_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "At most this share of a turn's trucks may arrive at Alexandria"},
        "rows": {"type": "array", "minItems": 6, "maxItems": 6, "items": {
          "type": "object", "required": ["die", "turns_1_30", "turns_31_107", "sources"], "additionalProperties": false,
          "properties": {"die": {"type": "integer", "minimum": 1, "maximum": 6},
                         "turns_1_30": {"$ref": "#/$defs/truckTriple"}, "turns_31_107": {"$ref": "#/$defs/truckTriple"},
                         "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}}},
    "infantry": {"type": "object", "required": ["bands", "arrive_turns_later", "rows"], "additionalProperties": false,
      "properties": {
        "bands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
                  "description": "Game-turn bands, in the order of each row's points; the turn is the one planned for"},
        "arrive_turns_later": {"type": "integer", "minimum": 0},
        "rows": {"type": "array", "minItems": 11, "maxItems": 11, "items": {
          "type": "object", "required": ["dice", "points", "sources"], "additionalProperties": false,
          "properties": {"dice": {"type": "integer", "minimum": 2, "maximum": 12},
                         "points": {"type": "array", "items": {"type": "integer", "minimum": 0}, "description": "Infantry replacement points per band (0 = the chart's 'none')"},
                         "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}}},
    "chart": {"type": "object", "required": ["tiger_convoy_turn", "rows"], "additionalProperties": false,
      "properties": {
        "tiger_convoy_turn": {"type": "integer", "minimum": 1, "description": "The Tiger convoy's tanks and planes arrive on this turn on top of the chart"},
        "rows": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["item", "total", "from_turn", "sources"], "additionalProperties": false,
          "properties": {
            "item": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "total": {"type": "integer", "minimum": 0, "description": "Replacement points of this type that may ever be brought in"},
            "max": {"type": "integer", "minimum": 1, "description": "Most that may be brought in per max_per; absent where the chart prints a dash"},
            "max_per": {"enum": ["turn", "month", "fortnight"], "description": "turn = per game-turn; month = calendar month (chart *); fortnight = weeks 1-2 and weeks 3-4 of a month (chart †)"},
            "from_turn": {"type": "integer", "minimum": 1, "description": "First game-turn the points may be planned for"},
            "to_turn": {"type": "integer", "minimum": 1, "description": "Last game-turn they may be planned for, where the chart gives one"},
            "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}}}
  }
}
