{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pilot-arrival.schema.json",
  "title": "Pilot Arrival Tables (34.88, 34.89)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "ratings",
    "nations"
  ],
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        }
      }
    }
  },
  "properties": {
    "table": {
      "const": "pilot-arrival"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ratings": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "nations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "nation",
          "from",
          "to",
          "rows"
        ],
        "additionalProperties": false,
        "properties": {
          "nation": {
            "enum": [
              "cw",
              "de",
              "it"
            ]
          },
          "from": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "rows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "dice",
                "pilots"
              ],
              "additionalProperties": false,
              "properties": {
                "dice": {
                  "type": "integer",
                  "minimum": 2,
                  "maximum": 12
                },
                "pilots": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "fixed": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "game_turn",
                "rating",
                "pilot"
              ],
              "additionalProperties": false,
              "properties": {
                "game_turn": {
                  "type": "integer"
                },
                "rating": {
                  "type": "integer"
                },
                "pilot": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
