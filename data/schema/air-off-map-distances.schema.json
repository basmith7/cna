{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "air-off-map-distances.schema.json",
  "title": "Air Distance Chart (SPI 37.4) and Allied Off-Map Air Facilities Chart (SPI 36.5, printed as 36.53)",
  "type": "object", "required": ["table", "sources", "places", "rows", "commonwealth_bases"], "additionalProperties": false,
  "$defs": {
    "place": {"enum": ["tunis", "gabes", "tripoli", "tripolitania", "malta", "crete", "sicily", "italy",
                       "nofilia", "benghazi", "derna", "tobruk", "bardia", "mersa-matruh", "alexandria"]},
    "hex": {"type": "string", "pattern": "^[A-E][0-9]{4}$"}
  },
  "properties": {
    "table": {"const": "air-off-map-distances"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "places": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "kind"], "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/place"},
        "kind": {"enum": ["box", "malta", "place"], "description": "box: an off-map holding box; malta: any hex of the Malta inset; place: the map hexes listed"},
        "hexes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hex"}, "description": "For kind place only: the place's hexes (places.json); any one of them"}}}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["part", "a", "b", "hexes", "sources"], "additionalProperties": false,
      "properties": {
        "part": {"enum": ["A", "B"], "description": "37.4 part A (Axis off-map North African areas) or B (North Mediterranean off-map areas)"},
        "a": {"$ref": "#/$defs/place"}, "b": {"$ref": "#/$defs/place"},
        "hexes": {"type": ["integer", "null"], "minimum": 1, "description": "Air distance in hexes; null is the chart's P: no direct flight between a and b (R-168)"},
        "sources": {"$ref": "common.schema.json#/$defs/sources"}}}},
    "commonwealth_bases": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "name", "flying_boat_basin", "entry_hex", "hexes", "max_squadrons", "sources"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "name": {"type": "string"},
        "flying_boat_basin": {"type": "boolean"},
        "entry_hex": {"$ref": "#/$defs/hex", "description": "The map-E edge hex the facility's planes enter and leave the map by"},
        "hexes": {"type": "integer", "minimum": 1, "description": "Hexes from the facility to its entry hex"},
        "max_squadrons": {"type": ["integer", "null"], "minimum": 1, "description": "null: unlimited"},
        "first_game_turn": {"type": "integer", "minimum": 1, "description": "No planes may be based here before this Game-Turn's first Operations Stage"},
        "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
