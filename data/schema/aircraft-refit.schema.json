{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aircraft-refit.schema.json",
  "title": "Aircraft Refit Table (38.38)",
  "type": "object",
  "required": ["table", "sources", "by_squadron", "by_squadron_modifiers", "by_plane"],
  "additionalProperties": false,
  "$defs": {
    "range": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
              "properties": {"from": {"type": "integer", "minimum": 1}, "to": {"type": "integer", "minimum": 1}}}
  },
  "properties": {
    "table": {"const": "aircraft-refit"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "by_squadron": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["die", "percent_refitted"], "additionalProperties": false,
                    "properties": {"die": {"$ref": "#/$defs/range"}, "percent_refitted": {"type": "integer", "minimum": 0, "maximum": 100}}}},
    "by_squadron_modifiers": {"type": "array", "items": {"type": "object", "required": ["when", "add"], "additionalProperties": false,
                              "properties": {"when": {"enum": ["aircraft-not-of-the-working-sgsus-squadron", "german", "italian"]}, "add": {"type": "integer"}}}},
    "by_plane": {"type": "object", "required": ["cw", "de", "it", "other_squadron_add"], "additionalProperties": false,
                 "properties": {"cw": {"$ref": "#/$defs/range"}, "de": {"$ref": "#/$defs/range"}, "it": {"$ref": "#/$defs/range"}, "other_squadron_add": {"type": "integer"}}}
  }
}
