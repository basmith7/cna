{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "supply-dump-capacity.schema.json",
 "title": "Supply Dump Capacity Chart (SPI 54.13; headed 54.12 on the chart sheet)",
 "type": "object",
 "required": [
  "table",
  "sources",
  "rows"
 ],
 "additionalProperties": false,
 "properties": {
  "table": {
   "const": "supply-dump-capacity"
  },
  "sources": {
   "$ref": "common.schema.json#/$defs/sources"
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rows": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "location",
     "ammo",
     "fuel",
     "stores",
     "water",
     "sources"
    ],
    "properties": {
     "location": {
      "enum": [
       "tunis-tripoli-box",
       "major-city",
       "village",
       "other-terrain",
       "non-dump"
      ]
     },
     "ammo": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 0
       },
       {
        "const": "unlimited"
       }
      ]
     },
     "fuel": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 0
       },
       {
        "const": "unlimited"
       }
      ]
     },
     "stores": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 0
       },
       {
        "const": "unlimited"
       }
      ]
     },
     "water": {
      "oneOf": [
       {
        "type": "integer",
        "minimum": 0
       },
       {
        "const": "unlimited"
       }
      ]
     },
     "sources": {
      "$ref": "common.schema.json#/$defs/sources"
     }
    }
   }
  }
 }
}
