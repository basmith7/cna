{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maneuver-adjustment.schema.json",
  "title": "Air-Air Combat Maneuver Adjustment Chart (45.4)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "to": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "table": {
      "const": "maneuver-adjustment"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "differential",
          "adjustment"
        ],
        "additionalProperties": false,
        "properties": {
          "differential": {
            "$ref": "#/$defs/range"
          },
          "adjustment": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
