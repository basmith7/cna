{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replacement-conversion.schema.json",
  "title": "Replacement Point Conversion Chart (SPI 20.3)",
  "type": "object", "required": ["table", "sources", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "replacement-conversion"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["unit", "cost", "sources"], "additionalProperties": false,
      "properties": {
        "unit": {"type": "string", "pattern": "^[a-z0-9-]+$", "description": "Unit type whose one TOE strength point is being rebuilt"},
        "cost": {"type": "array", "description": "Alternatives (any one suffices); each alternative is the list of replacement points spent together. Empty = no replacement points needed",
                 "items": {"type": "array", "minItems": 1, "items": {
                   "type": "object", "required": ["class", "points"], "additionalProperties": false,
                   "properties": {"class": {"enum": ["infantry", "gun", "armoured-recce", "light-tank", "tank", "artillery", "italian-para-artillery", "german-75mm-light-gun", "anti-tank", "light-anti-tank", "anti-air", "supplies"]},
                                  "points": {"type": "integer", "minimum": 1}}}}},
        "applies_to": {"type": "string", "description": "Our short restatement of the chart's lettered qualification, where one applies"},
        "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
