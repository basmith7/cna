{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Shared definitions for CNA Living Rules data",
  "$defs": {
    "caseRef": {"type": "string", "pattern": "^CNA1979:[1-9][0-9]?\\.[0-9]{1,2}$",
                "description": "SPI 1979 rules case, e.g. CNA1979:8.37; section.0 is the section itself"},
    "scanRef": {"type": "string", "pattern": "^scan:p[0-9]{1,4}$",
                "description": "archive.org jp2 index (0-based), as used by tools/fetch.py"},
    "vassalRef": {"type": "string", "pattern": "^vassal:[A-Za-z0-9._-]+$",
                  "description": "VASSAL module the value was read from (tools/sources.json → vassal)"},
    "sourceRef": {"oneOf": [{"$ref": "#/$defs/caseRef"}, {"$ref": "#/$defs/scanRef"}, {"$ref": "#/$defs/vassalRef"}]},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
    "hexId": {"type": "string", "pattern": "^[A-EM][0-9]{4}$",
              "description": "Map sheet letter (A–E, M = Malta) + RRCC as printed, e.g. C4023"},
    "mapTerrain": {"enum": ["clear", "gravel", "salt-marsh", "heavy-vegetation", "rough", "mountain", "delta", "desert", "major-city", "swamp", "sea"],
                   "description": "Hex fills of the Terrain Key; settlements are a separate field"},
    "settlement": {"enum": [null, "major-city", "village", "bir", "oasis"]},
    "hexsideFeature": {"enum": ["escarpment", "ridge", "slope", "wadi", "major-river", "minor-river", "road", "unfinished-road", "railroad", "unfinished-railroad", "track", "coast", "lake"]},
    "hexSide": {"enum": ["E", "SE", "SW", "W", "NW", "NE"]},
    "hexside": {"type": "object", "required": ["a", "b"], "additionalProperties": false,
                "properties": {"a": {"$ref": "#/$defs/hexId"}, "b": {"$ref": "#/$defs/hexId"}},
                "description": "Unordered pair; convention a < b (checked by check_data once a table uses it)"},
    "side": {"enum": ["cw", "axis"]},
    "nation": {"enum": ["cw", "it", "de"]},
    "weather": {"enum": ["normal", "hot", "sandstorm", "rainstorm"]},
    "unitType": {"enum": ["infantry", "tank", "recce", "anti-tank", "anti-aircraft", "artillery",
                          "engineer", "aircraft", "ground-support", "recovery", "dummy-tank", "truck", "hq"]},
    "unitClass": {"enum": ["infantry", "armor", "gun", "truck"]},
    "supplyType": {"enum": ["ammo", "fuel", "stores", "water"]},
    "phase": {"enum": ["initiative-declaration", "weather", "organisation", "arrival", "cw-fleet",
                       "reserve-designation", "movement-combat", "truck-convoy", "rail", "repair", "patrol"],
              "description": "SPI phases A–L of an Operations Stage (there is no I)"},
    "terrain": {"enum": ["clear", "gravel", "salt-marsh", "heavy-vegetation", "rough", "mountain", "delta", "desert", "major-city",
                         "swamp", "village-bir-oasis", "railroad", "road", "track", "escarpment", "pass", "sea"],
                "description": "Hex terrain types of the Terrain Effects Chart (8.37, tables/terrain-effects.json) plus the map's escarpment, pass and sea"},
    "unitId": {"type": "string", "pattern": "^unit:(cw|it|de):[a-z0-9][a-z0-9-]*$",
               "description": "A counter on an OA sheet: unit:<nation>:<slug> (data/oa/<nation>.json)"},
    "scenarioId": {"type": "string", "pattern": "^scenario:[a-z0-9][a-z0-9-]*$",
                   "description": "A scenario: scenario:<slug> = data/scenarios/<slug>.json"},
    "gameTime": {"type": "object", "required": ["game_turn", "opstage"], "additionalProperties": false,
                 "properties": {"game_turn": {"type": "integer", "minimum": 1, "maximum": 111},
                                "opstage": {"type": "integer", "minimum": 1, "maximum": 3}},
                 "description": "A Game-Turn and one of its three Operations Stages"},
    "toe": {"type": "array", "items": {"type": "object", "required": ["weapon", "points"], "additionalProperties": false,
                                       "properties": {"weapon": {"type": "string", "minLength": 1},
                                                      "points": {"type": "integer", "minimum": 0}}},
            "description": "TOE Strength Points by weapon system, as named on the OA sheet (key into tables/weapon-systems.json)"},
    "trucks": {"type": "object", "additionalProperties": false,
               "properties": {"light": {"type": "integer", "minimum": 0}, "medium": {"type": "integer", "minimum": 0},
                              "heavy": {"type": "integer", "minimum": 0}},
               "description": "Truck points by class (21.0)"}
  }
}
