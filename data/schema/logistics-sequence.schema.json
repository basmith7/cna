{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "logistics-sequence.schema.json",
  "title": "Logistics Game sequence of play (SPI 48.0), tagged by the Land Game point (5.2) each step attaches to",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "logistics-sequence"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["order", "stage", "name", "frequency", "actor", "attaches_to", "new_in_logistics", "air_game_only", "logistics_game_only"],
        "additionalProperties": false,
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "stage": {"enum": ["I", "II", "III", "IV", "V", "VIII", "IX"],
                    "description": "Roman stage as printed; VI and VII repeat V and are not listed"},
          "phase": {"type": "string", "pattern": "^[A-L]$"},
          "segment": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "frequency": {"enum": ["turn", "stage"]},
          "actor": {"enum": ["both", "axis", "cw", "initiative-holder", "player-a"],
                    "description": "player-a: done by Player A, then by Player B with the labels swapped"},
          "attaches_to": {"anyOf": [{"$ref": "common.schema.json#/$defs/phase"},
                                    {"enum": ["initiative-determination", "naval-convoy", "turn-end", null]}]},
          "new_in_logistics": {"type": "boolean", "description": "No counterpart in the Land Game outline (5.2)"},
          "air_game_only": {"type": "boolean"},
          "logistics_game_only": {"type": "boolean", "description": "Only in the Logistics Game; absent from the Land-and-Air sequence (33.0)"},
          "repeat_as": {"type": "array", "items": {"enum": ["VI", "VII"]}}
        }
      }
    }
  }
}
