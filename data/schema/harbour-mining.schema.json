{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harbour-mining.schema.json",
  "title": "Mining Harbor by Plane Table (41.52)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "table": {
      "const": "harbour-mining"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "bombload",
          "mined"
        ],
        "additionalProperties": false,
        "properties": {
          "bombload": {
            "type": "object",
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          "mined": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          }
        }
      }
    }
  }
}
