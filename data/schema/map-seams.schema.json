{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "map-seams.schema.json",
  "title": "Hexes that touch across each sheet edge (generated by tools/map_seams.py)",
  "type": "object",
  "required": ["sources", "seams"],
  "additionalProperties": false,
  "properties": {
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "seams": {
      "type": "array",
      "items": {
        "type": "object", "required": ["west", "east", "pairs"], "additionalProperties": false,
        "properties": {
          "west": {"type": "string", "pattern": "^[A-E]$"},
          "east": {"type": "string", "pattern": "^[A-E]$"},
          "pairs": {
            "type": "array",
            "items": {
              "type": "object", "required": ["west", "west_side", "east", "east_side", "features"], "additionalProperties": false,
              "properties": {
                "west": {"$ref": "common.schema.json#/$defs/hexId"},
                "west_side": {"enum": ["E", "NE", "SE"]},
                "east": {"$ref": "common.schema.json#/$defs/hexId"},
                "east_side": {"enum": ["W", "SW", "NW"]},
                "features": {"type": "array", "items": {"type": "string"}, "description": "Union of the two edge records' features (hexsides.json HEX|SIDE)"},
                "one_side_only": {"type": "array", "minItems": 1, "items": {"type": "string"}, "description": "Features on only one sheet's edge record"}
              }
            }
          }
        }
      }
    }
  }
}
