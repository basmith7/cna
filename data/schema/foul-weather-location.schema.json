{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foul-weather-location.schema.json",
  "title": "Foul Weather Location Table (SPI 29.7)",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "foul-weather-location"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "required": ["die", "sections", "delta_sandstorm_is_normal", "sources"], "additionalProperties": false,
        "properties": {
          "die": {"type": "integer", "minimum": 1, "maximum": 6},
          "sections": {"type": "array", "minItems": 1, "items": {"enum": ["A", "B", "C", "D", "E"]},
                       "description": "Map sheets on which the sandstorm or rainstorm falls; the rest have normal weather"},
          "delta_sandstorm_is_normal": {"type": "boolean", "description": "The chart's asterisk: a sandstorm on a Nile Delta hex counts as normal weather"},
          "sources": {"$ref": "common.schema.json#/$defs/sources"}
        }
      }
    }
  }
}
