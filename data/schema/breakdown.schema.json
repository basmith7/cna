{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "breakdown.schema.json",
  "title": "Breakdown Table (SPI 21.38)",
  "type": "object",
  "required": ["table", "sources", "columns", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "breakdown"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "columns": {
      "type": "array", "minItems": 1,
      "description": "Accumulated breakdown point bands (after BAR and weather column shifts), in printed order",
      "items": {"type": "object", "required": ["id", "min", "max"], "additionalProperties": false,
                "properties": {"id": {"type": "string"}, "min": {"type": "integer", "minimum": 0},
                               "max": {"type": ["integer", "null"], "minimum": 0}}}
    },
    "rows": {
      "type": "array", "minItems": 1,
      "description": "One record per cell: in a band, this sequential dice range means this percentage of the vehicle type breaks down",
      "items": {"type": "object", "required": ["column", "percent", "dice", "sources"], "additionalProperties": false,
                "properties": {"column": {"type": "string"},
                               "percent": {"enum": [0, 10, 25, 33, 50, 75]},
                               "dice": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
                                        "properties": {"from": {"type": "integer", "minimum": 11, "maximum": 66},
                                                       "to": {"type": "integer", "minimum": 11, "maximum": 66}}},
                               "sources": {"$ref": "common.schema.json#/$defs/sources"}}}
    }
  }
}
