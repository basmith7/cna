{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "close-assault-results.schema.json",
  "title": "Close assault combat results table (SPI 15.79)",
  "type": "object",
  "required": ["table", "sources", "columns", "losses", "sums"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "close-assault-results"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "columns": {
      "type": "array", "minItems": 1,
      "description": "Final differential bands in printed order; min/max null = open-ended end column",
      "items": {"type": "object", "required": ["id", "min", "max", "et", "overrun"], "additionalProperties": false,
                "properties": {"id": {"type": "string", "pattern": "^[-+]?[0-9]+$"},
                               "min": {"type": ["integer", "null"]}, "max": {"type": ["integer", "null"]},
                               "et": {"type": "boolean", "description": "an end column (ET Seq on the chart)"},
                               "overrun": {"type": "boolean"}}}
    },
    "losses": {
      "type": "object", "required": ["attacker", "defender"], "additionalProperties": false,
      "properties": {"attacker": {"$ref": "#/$defs/lossGrid"}, "defender": {"$ref": "#/$defs/lossGrid"}}
    },
    "sums": {
      "type": "object",
      "required": ["capture_attacker", "capture_defender", "engaged", "retreat_1", "retreat_2", "retreat_3"],
      "additionalProperties": false,
      "properties": {
        "capture_attacker": {"$ref": "#/$defs/sumRow"}, "capture_defender": {"$ref": "#/$defs/sumRow"},
        "engaged": {"$ref": "#/$defs/sumRow"},
        "retreat_1": {"$ref": "#/$defs/sumRow"}, "retreat_2": {"$ref": "#/$defs/sumRow"}, "retreat_3": {"$ref": "#/$defs/sumRow"}
      }
    },
    "known_gaps": {
      "type": "array",
      "description": "Readings no loss row covers, as printed; each needs a ruling or an errata item",
      "items": {"type": "object", "required": ["side", "column", "readings"], "additionalProperties": false,
                "properties": {"side": {"enum": ["attacker", "defender"]}, "column": {"type": "string"},
                               "readings": {"type": "array", "items": {"type": "integer", "minimum": 11, "maximum": 66}}}}
    }
  },
  "$defs": {
    "diceRange": {"type": ["object", "null"], "required": ["from", "to"], "additionalProperties": false,
                  "properties": {"from": {"type": "integer", "minimum": 11, "maximum": 66},
                                 "to": {"type": "integer", "minimum": 11, "maximum": 68}},
                  "description": "Sequential two-dice reading range; 'to' allows up to 68 only because one printed cell reads 13-18"},
    "lossGrid": {"type": "object", "description": "percent-loss row -> column id -> dice range or null",
                 "required": ["50", "40", "30", "25", "20", "15", "10", "5", "0"], "additionalProperties": false,
                 "patternProperties": {"^(50|40|30|25|20|15|10|5|0)$": {
                   "type": "object", "additionalProperties": {"$ref": "#/$defs/diceRange"}}}},
    "sumRow": {"type": "object", "description": "column id -> sorted list of dice sums (2-12), or null for never",
               "additionalProperties": {"type": ["array", "null"], "items": {"type": "integer", "minimum": 2, "maximum": 12}}}
  }
}
