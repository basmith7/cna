{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "air-missions.schema.json",
  "title": "Aircraft Mission Summary (39.5)",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "air-missions"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "mission", "kind", "side", "role", "night", "cases"], "additionalProperties": false,
             "properties": {
               "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
               "mission": {"type": "string"},
               "kind": {"enum": ["strategic", "land_support"]},
               "side": {"enum": ["cw", "axis", "both"]},
               "role": {"enum": ["fighter", "bombing", "non-combat"]},
               "night": {"type": "boolean"},
               "bombardment_table": {"type": "boolean"},
               "cases": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}}}}}
  }
}
