{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "barrage-results.schema.json",
  "title": "Barrage against land units combat results table (SPI 12.6)",
  "type": "object",
  "required": ["table", "sources", "columns", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "barrage-results"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "columns": {
      "type": "array", "minItems": 1,
      "description": "Barrage-point bands (actual points after any terrain shift), in printed order",
      "items": {
        "type": "object", "required": ["id", "min", "max"], "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[0-9]+(-[0-9]+|\\+)$"},
          "min": {"type": "integer", "minimum": 1},
          "max": {"type": ["integer", "null"], "minimum": 1, "description": "null = open-ended"}
        }
      }
    },
    "rows": {
      "type": "array", "minItems": 1,
      "description": "One record per cell: the dice range (sequential two-dice reading 11–66) that yields a result for a target class in a column",
      "items": {
        "type": "object",
        "required": ["class", "column", "result", "dice", "sources"],
        "additionalProperties": false,
        "properties": {
          "class": {"$ref": "common.schema.json#/$defs/unitClass"},
          "column": {"type": "string", "pattern": "^[0-9]+(-[0-9]+|\\+)$"},
          "result": {"enum": ["no-effect", "pinned", "lose-1", "lose-2"],
                     "description": "no-effect; pinned (SPI 12.44); lose-1 / lose-2 = that many TOE points lost, and for infantry or armor also pinned (SPI 12.45)"},
          "dice": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
                   "properties": {"from": {"type": "integer", "minimum": 11, "maximum": 66},
                                  "to": {"type": "integer", "minimum": 11, "maximum": 66}}},
          "sources": {"$ref": "common.schema.json#/$defs/sources"}
        }
      }
    }
  }
}
