{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ammunition-consumption.schema.json",
  "title": "Ammunition Consumption Rates Chart (SPI 50.2; headed 'Table' on the chart sheet)",
  "type": "object", "required": ["table", "sources", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "ammunition-consumption"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["mode", "action", "ammo", "sources"], "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["played", "abstracted"], "description": "Chart half: Logistics Game played (cost per TOE Strength Point) or abstracted (cost per unit)"},
        "action": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "applies_to": {"type": "array", "items": {"type": "string"}, "description": "Unit classes the row names, where it names any"},
        "ammo": {"oneOf": [{"type": "integer", "minimum": 1}, {"enum": ["bombload", "tacair-bombload"]}],
                 "description": "Ammunition Points spent; a word where the chart prints a plane rating instead of a number"},
        "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
