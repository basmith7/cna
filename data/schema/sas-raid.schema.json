{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sas-raid.schema.json",
  "title": "Special Air Service Brigade Raid Table (SPI 27.93)",
  "type": "object", "required": ["table", "sources", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "sas-raid"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["die", "percent", "sources"], "additionalProperties": false,
      "properties": {"die": {"$ref": "die-lookup.schema.json#/$defs/dieRange"},
                     "percent": {"type": "integer", "minimum": 0, "maximum": 100,
                                 "description": "Share of the aircraft on the ground in the raided hex that are destroyed"},
                     "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
