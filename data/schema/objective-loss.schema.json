{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "objective-loss.schema.json",
  "title": "Objective Loss Table (SPI 16.8)",
  "type": "object", "required": ["table", "sources", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "objective-loss"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["die", "killed", "captured", "sources"], "additionalProperties": false,
      "properties": {"die": {"$ref": "die-lookup.schema.json#/$defs/dieRange"},
                     "killed": {"type": "integer", "minimum": 0, "description": "TOE points lost by the patrolled hex"},
                     "captured": {"type": "integer", "minimum": 0, "description": "TOE points captured; becomes killed if the patrol was wiped out (chart asterisk)"},
                     "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
