{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "training.schema.json",
  "title": "Training Chart (SPI 17.6)",
  "type": "object", "required": ["table", "sources", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "training"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["type", "stages", "sources"], "additionalProperties": false,
      "properties": {"type": {"enum": ["infantry", "tank-or-recce", "gun", "commando", "commonwealth-unit-morale"]},
                     "stages": {"type": "integer", "minimum": 1, "description": "Operations stages of training"},
                     "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
