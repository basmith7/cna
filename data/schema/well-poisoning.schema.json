{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "well-poisoning.schema.json",
  "title": "Poisoning and Sweetening Wells Table (SPI 52.8)",
  "type": "object", "required": ["table", "sources", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "well-poisoning"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["attempt", "cp", "success_on", "retry_same_stage", "sources"], "additionalProperties": false,
      "properties": {"attempt": {"enum": ["poison", "sweeten"]},
                     "cp": {"type": "integer", "minimum": 0, "description": "CP per attempt (SPI 52.16, 52.17)"},
                     "success_on": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 6}},
                     "retry_same_stage": {"type": "boolean", "description": "Whether another attempt on the same well is allowed in the same Operations Stage"},
                     "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
