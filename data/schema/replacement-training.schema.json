{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replacement-training.schema.json",
  "title": "Operations stages of training required by replacement point class (SPI 20.43)",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "replacement-training"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["class", "stages", "sources"],
        "additionalProperties": false,
        "properties": {
          "class": {"enum": ["gun", "infantry", "tank", "armoured-car", "recce"]},
          "stages": {"type": "integer", "minimum": 0, "description": "Operations stages, the stage of arrival included"},
          "sources": {"$ref": "common.schema.json#/$defs/sources"}
        }
      }
    }
  }
}
