{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "morale-modifier.schema.json",
  "title": "Morale Modifier Table (SPI 17.4)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "table": {
      "const": "morale-modifier"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "level",
          "modifier",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "integer",
            "minimum": -17,
            "maximum": 8,
            "description": "Cohesion (disorganisation) level; 8 means +8 or better, -17 means -17 or worse"
          },
          "modifier": {
            "type": "object",
            "required": [
              "+4",
              "+3",
              "+2",
              "+1",
              "0",
              "-1",
              "-2",
              "-3",
              "-4",
              "surrender"
            ],
            "additionalProperties": false,
            "description": "modifier to basic morale -> sequential dice range yielding it; 'surrender' = all the units surrender (SPI 17.26 exception)",
            "patternProperties": {
              "^([+-][1-4]|0|surrender)$": {
                "$ref": "#/$defs/dice"
              }
            }
          },
          "sources": {
            "$ref": "common.schema.json#/$defs/sources"
          }
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "description": "Readings no column covers, as printed; each needs a ruling or an errata item",
      "items": {
        "type": "object",
        "required": [
          "level",
          "readings"
        ],
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "integer"
          },
          "readings": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 11,
              "maximum": 66
            }
          }
        }
      }
    }
  },
  "$defs": {
    "dice": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 11,
          "maximum": 66
        },
        "to": {
          "type": "integer",
          "minimum": 11,
          "maximum": 66
        }
      }
    }
  }
}
