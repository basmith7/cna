{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raid-on-rommel.schema.json",
  "title": "Raid on Rommel Table (SPI 27.92)",
  "type": "object", "required": ["table", "sources", "lrdg_eliminated_unless_hex_empty", "rows"], "additionalProperties": false,
  "properties": {
    "table": {"const": "raid-on-rommel"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "lrdg_eliminated_unless_hex_empty": {"const": true, "description": "An 'lrdg-eliminated' result is waived when no combat or HQ unit is in Rommel's hex (chart key)"},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["dice", "result", "sources"], "additionalProperties": false,
      "properties": {
        "dice": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
                 "properties": {"from": {"type": "integer", "minimum": 2, "maximum": 12}, "to": {"type": "integer", "minimum": 2, "maximum": 12}},
                 "description": "Two-dice total"},
        "result": {"enum": ["axis-initiative-3-temporary", "lrdg-eliminated", "none", "rommel-removed"],
                   "description": "axis-initiative-3-temporary: the Axis initiative rating is 3 for the next 'turns' initiative determinations; rommel-removed: take the Rommel counter off the map for good"},
        "turns": {"type": "integer", "minimum": 1},
        "sources": {"$ref": "common.schema.json#/$defs/sources"}}}}
  }
}
