{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "truck-characteristics.schema.json",
 "title": "Truck Characteristics Chart (SPI 54.2)",
 "type": "object",
 "required": [
  "table",
  "sources",
  "rows"
 ],
 "additionalProperties": false,
 "properties": {
  "table": {
   "const": "truck-characteristics"
  },
  "sources": {
   "$ref": "common.schema.json#/$defs/sources"
  },
  "notes": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "rows": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "truck",
     "cpa",
     "toe",
     "supply_points",
     "fuel_capacity",
     "fuel_consumption",
     "bar",
     "sources"
    ],
    "properties": {
     "truck": {
      "enum": [
       "light",
       "medium",
       "heavy"
      ]
     },
     "cpa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "infantry",
       "guns",
       "supplies"
      ],
      "properties": {
       "infantry": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "guns": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "supplies": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       }
      },
      "description": "CPA of the truck point while motorising infantry or guns, or (convoys only) carrying supplies; null = the chart's 'na' (not allowed)"
     },
     "toe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "infantry",
       "artillery",
       "anti_aircraft"
      ],
      "properties": {
       "infantry": {
        "type": [
         "number",
         "null"
        ],
        "minimum": 0
       },
       "artillery": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "anti_aircraft": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       }
      },
      "description": "TOE Strength Points of each kind one truck point carries; 0.5 = two truck points per TOE point (chart note †)"
     },
     "supply_points": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ammo",
       "fuel",
       "stores",
       "water"
      ],
      "properties": {
       "ammo": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "fuel": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "stores": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       },
       "water": {
        "type": [
         "integer",
         "null"
        ],
        "minimum": 0
       }
      }
     },
     "fuel_capacity": {
      "type": "integer",
      "minimum": 0
     },
     "fuel_consumption": {
      "type": "integer",
      "minimum": 0
     },
     "bar": {
      "type": "string",
      "pattern": "^[0-9]+[LR]$",
      "description": "Breakdown Adjustment Rating, column shifts"
     },
     "off_road_extra_breakdown": {
      "const": true,
      "description": "Chart note ‡: one extra breakdown point per hex entered and hexside crossed when not moving along a road"
     },
     "sources": {
      "$ref": "common.schema.json#/$defs/sources"
     }
    }
   }
  }
 }
}
