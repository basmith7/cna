{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stacking-point-values.schema.json",
  "title": "Stacking Point Values chart (SPI 9.4)",
  "type": "object", "required": ["table", "sources", "rows", "per_five_points"], "additionalProperties": false,
  "properties": {
    "table": {"const": "stacking-point-values"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["equivalent", "sp", "shell_of", "sources"], "additionalProperties": false,
      "properties": {"equivalent": {"enum": ["division", "super-brigade", "brigade", "battalion", "company"],
                                    "description": "Unit equivalent at full strength (SPI 9.2); 'brigade' covers standard brigades and battle groups; a super brigade is an infantry-light division in all but name (chart note)"},
                     "sp": {"type": "integer", "minimum": 0},
                     "shell_of": {"type": "array", "items": {"enum": ["division", "brigade", "battle-group", "battalion", "hq-with-attachments"]},
                                  "description": "Formations that count at this row's value when they are shells (SPI 9.26-9.28)"},
                     "sources": {"$ref": "common.schema.json#/$defs/sources"}}}},
    "per_five_points": {"type": "object", "required": ["truck-convoy", "replacement-points"], "additionalProperties": false,
                        "description": "SP per five points or fraction thereof; the truck-convoy rate matters only for road/track CP cost applicability (chart dagger)",
                        "properties": {"truck-convoy": {"type": "number", "minimum": 0}, "replacement-points": {"type": "number", "minimum": 0}}}
  }
}
