{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis-air-reinforcement-schedule.schema.json",
  "title": "Axis Airplane Reinforcement Chart (printed as 34.85 on the Axis chart sheet)",
  "type": "object",
  "required": ["table", "sources", "rows"],
  "additionalProperties": false,
  "properties": {
    "table": {"const": "axis-air-reinforcement-schedule"},
    "sources": {"$ref": "common.schema.json#/$defs/sources"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "marks": {"type": "object", "description": "Footnote marks, as printed", "additionalProperties": {"type": "string"}},
    "rows": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["period", "game_turns", "arrivals", "sources"], "additionalProperties": false,
      "properties": {
        "period": {"type": "string"},
        "game_turns": {"type": "object", "required": ["from", "to"], "additionalProperties": false,
                       "properties": {"from": {"type": "integer", "minimum": 1}, "to": {"type": "integer", "minimum": 1}}},
        "arrivals": {"type": "array", "minItems": 1, "items": {
          "type": "object", "required": ["nation", "count", "aircraft", "aircraft_id"], "additionalProperties": false,
          "properties": {
            "nation": {"enum": ["german", "italian"]},
            "count": {"type": ["integer", "null"], "minimum": 1, "description": "null where the printed count is not a number; see count_as_printed"},
            "count_as_printed": {"type": "string"},
            "aircraft": {"type": "string", "minLength": 1},
            "aircraft_id": {"type": "string", "pattern": "^aircraft:(cw|it|de):[a-z0-9][a-z0-9-]*$", "description": "The tables/aircraft-characteristics.json row this entry is (never an alternative_of row: those are the same plane in another configuration); names with no row of their own follow R-169"},
            "mark": {"type": "string", "pattern": "^[*†]$"}
          }}},
        "sources": {"$ref": "common.schema.json#/$defs/sources"}
      }}}
  }
}
