{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strafing.schema.json",
  "title": "Strafing Table (40.8)",
  "type": "object",
  "required": [
    "table",
    "sources",
    "columns",
    "shifts",
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "object",
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "type": "integer",
          "minimum": 0
        },
        "to": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    }
  },
  "properties": {
    "table": {
      "const": "strafing"
    },
    "sources": {
      "$ref": "common.schema.json#/$defs/sources"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "columns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/range"
      }
    },
    "shifts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "columns"
        ],
        "additionalProperties": false,
        "properties": {
          "target": {
            "enum": [
              "trucks-in-convoy",
              "supply-dump",
              "infantry",
              "armour"
            ]
          },
          "fortification_level": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "columns": {
            "type": "integer"
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "result",
          "dice"
        ],
        "additionalProperties": false,
        "properties": {
          "result": {
            "type": "integer",
            "minimum": 0
          },
          "dice": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/range"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
